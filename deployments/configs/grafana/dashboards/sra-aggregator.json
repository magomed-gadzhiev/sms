        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "text",
      "title": "Ops Reference",
      "id": 8,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "**Stuck rows detail:** see `/admin/sra-stuck` in portal.\n\n**Reset a stuck row:** `POST /admin/network/sra-stuck/{client_id}/reset`\n\n**give-up threshold:** materialize_retry_count >= 100\n\n**Backlog cap:** RetryPendingOnce reads LIMIT 100 per tick (1 min)."
      }
    },
    {
      "type": "timeseries",
      "title": "Initial Failure Rate (real degradation)",
      "description": "Rate of first-time PUT/Bulk materialize failures (source=initial). These represent genuine new degradation — alert on this panel, not retry.",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(portal_materialize_failure_total{source=\"initial\"}[5m])",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "type": "timeseries",
      "title": "Retry Failure Rate (informational)",
      "description": "Rate of retry-loop tick failures (source=retry). These amplify cardinality for existing stuck rows — do NOT alert on this panel; use for root-cause investigation only.",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(portal_materialize_failure_total{source=\"retry\"}[5m])",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "type": "timeseries",
      "title": "Pending Queue Trend",
      "description": "portal_sra_pending_retry_count over time. Gauge is capped at 100 (LIMIT per tick). Sustained value at 100 indicates backlog overflow — watch Backlog Overflow Rate panel.",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "portal_sra_pending_retry_count",
          "legendFormat": "pending retries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "single", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "type": "timeseries",
      "title": "Backlog Overflow Rate",
      "description": "rate(portal_sra_retry_backlog_overflow_total[15m]). Non-zero means RetryPendingOnce hit the LIMIT 100 cap — pending queue exceeds tick capacity (max ~6000/h). Sustained signal: scale retry workers or investigate root cause.",
