{
  "uid": "load-test-live",
  "title": "Live Load Test",
  "description": "Real-time dashboard for SMS load test monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "tags": ["load-test", "live", "sms"],
  "templating": {
    "list": [
      {
        "name": "client_id",
        "label": "Client",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgresql"
        },
        "query": "SELECT id AS __value, name AS __text FROM clients WHERE active = true ORDER BY name",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "LoadTest-Dummy",
          "value": "00000000-0000-0000-0000-000000000001"
        },
        "sort": 1
      },
      {
        "name": "time_range",
        "label": "Session Duration",
        "type": "interval",
        "query": "5m,15m,30m,1h,2h",
        "current": {
          "selected": true,
          "text": "30m",
          "value": "30m"
        },
        "options": [
          {"selected": false, "text": "5m", "value": "5m"},
          {"selected": false, "text": "15m", "value": "15m"},
          {"selected": true, "text": "30m", "value": "30m"},
          {"selected": false, "text": "1h", "value": "1h"},
          {"selected": false, "text": "2h", "value": "2h"}
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgresql"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Balance Zero",
        "rawQuery": "SELECT created_at AS time, 'Balance reached zero' AS text FROM transactions WHERE balance_after <= 0 AND client_id = '$client_id' ORDER BY created_at"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Finance",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Current Balance",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "targets": [
        {
          "rawSql": "SELECT balance AS \"Balance\", currency AS \"Currency\" FROM accounts WHERE client_id = '$client_id'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 100},
              {"color": "green", "value": 1000}
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Balance$/"
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Accumulated Cost",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "targets": [
        {
          "rawSql": "SELECT SUM(total_amount) AS \"Cost\" FROM tarification_log WHERE client_id = '$client_id' AND created_at >= NOW() - INTERVAL '$time_range'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 500},
              {"color": "red", "value": 1000}
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Cost$/"
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Balance Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "targets": [
        {
          "rawSql": "SELECT created_at AS time, balance_after AS \"Balance\" FROM transactions WHERE client_id = '$client_id' AND created_at >= NOW() - INTERVAL '$time_range' ORDER BY created_at",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "pointSize": 5,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto"
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Messages",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 5,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Messages Sent",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "sum(smpp_messages_sent_total)",
          "legendFormat": "Sent",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Messages Delivered",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 10},
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Delivered\" FROM messages WHERE status = 'delivered' AND client_id = '$client_id' AND delivered_at >= NOW() - INTERVAL '$time_range'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Delivered$/"
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "Messages Failed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 10},
      "targets": [
        {
          "expr": "sum(smpp_messages_failed_total)",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Messages Queued",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 10},
      "targets": [
        {
          "expr": "sum(sms_messages_queued_total)",
          "legendFormat": "Queued",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "yellow", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "Performance",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 10,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "title": "Throughput (msg/s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "targets": [
        {
          "expr": "sum(rate(smpp_messages_sent_total[1m]))",
          "legendFormat": "msg/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          },
          "unit": "locale",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "Delivery Rate %",
      "type": "gauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "targets": [
        {
          "rawSql": "SELECT ROUND(COUNT(*) FILTER (WHERE status = 'delivered')::numeric / NULLIF(COUNT(*) FILTER (WHERE status IN ('delivered', 'failed')), 0) * 100, 2) AS \"Delivery Rate\" FROM messages WHERE client_id = '$client_id' AND created_at >= NOW() - INTERVAL '$time_range'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 80},
              {"color": "green", "value": 95}
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Delivery Rate$/"
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "id": 13,
      "title": "Throughput Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "targets": [
        {
          "expr": "sum(rate(smpp_messages_sent_total[1m]))",
          "legendFormat": "msg/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisPlacement": "auto"
          },
          "unit": "locale",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Providers",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 14,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "title": "Traffic by Provider",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "sum by (provider_name)(smpp_messages_sent_total)",
          "legendFormat": "{{provider_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      }
    },
    {
      "id": 16,
      "title": "Provider Latency (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider_name)(rate(smpp_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider_name}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisPlacement": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Operators",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
      "id": 17,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 18,
      "title": "Traffic by Operator",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "targets": [
        {
          "rawSql": "SELECT LEFT(destination, 5) AS \"Operator\", COUNT(*) AS \"Messages\" FROM messages WHERE client_id = '$client_id' AND created_at >= NOW() - INTERVAL '$time_range' GROUP BY LEFT(destination, 5) ORDER BY COUNT(*) DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^Messages$/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      }
    },
    {
      "id": 19,
      "title": "Delivery Rate by Provider",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
      "targets": [
        {
          "rawSql": "SELECT am.period_start AS time, p.name AS metric, ROUND(SUM(am.count) FILTER (WHERE am.status = 'delivered')::numeric / NULLIF(SUM(am.count) FILTER (WHERE am.status IN ('delivered', 'failed')), 0) * 100, 2) AS value FROM aggregated_metrics am JOIN providers p ON am.provider_id = p.id WHERE am.period = 'minute' AND am.client_id = '$client_id' AND am.period_start >= NOW() - INTERVAL '$time_range' GROUP BY am.period_start, p.name ORDER BY am.period_start",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisPlacement": "auto"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "title": "Message Feed",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 45},
      "id": 20,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "title": "Recent Messages",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 46},
      "targets": [
        {
          "rawSql": "SELECT m.created_at AS \"Time\", CONCAT(LEFT(m.destination, 3), '***', RIGHT(m.destination, 4)) AS \"Destination\", m.status AS \"Status\", p.name AS \"Provider\", EXTRACT(EPOCH FROM (COALESCE(m.delivered_at, m.updated_at) - m.created_at))::int AS \"Latency (s)\" FROM messages m LEFT JOIN providers p ON m.provider_id = p.id WHERE m.client_id = '$client_id' ORDER BY m.created_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-text"
              },
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"delivered": {"color": "green", "text": "delivered"}}},
                  {"type": "value", "options": {"failed": {"color": "red", "text": "failed"}}},
                  {"type": "value", "options": {"sent": {"color": "blue", "text": "sent"}}},
                  {"type": "value", "options": {"queued": {"color": "yellow", "text": "queued"}}},
                  {"type": "value", "options": {"pending": {"color": "orange", "text": "pending"}}}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Latency (s)"},
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Time"},
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {"displayName": "Time", "desc": true}
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Historical Graphs",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 56},
      "id": 22,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 23,
      "title": "msg/s History",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 57},
      "targets": [
        {
          "expr": "sum(rate(smpp_messages_sent_total[1m]))",
          "legendFormat": "msg/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
